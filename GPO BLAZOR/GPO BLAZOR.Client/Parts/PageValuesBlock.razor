@using GPO_BLAZOR.Client.Class.Date


<body>
    @if(Date != null) {
        <h2>
            @Date.PageName
        </h2>
        @foreach (IBlock temp in Date.Date)
        {
            <Block Date="temp" ID=@ID/>
        }
    }
    else
    {

    }
</body>

@code {
    [Parameter]
    public IPage Date { get; set; }
    [Parameter]
    public string? ID { get; init; }

}
